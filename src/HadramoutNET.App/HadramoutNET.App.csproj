<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>../../reference/python-v1.1.3/assets/hadramout_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HadramoutNET.Core/HadramoutNET.Core.csproj" />
    <!-- Link original visual assets by copy only. The Python repo and
         pinned source images are never moved or modified. -->
    <Resource Include="../../reference/python-v1.1.3/assets/dashboard_icons/*.png"
              Link="Assets/DashboardIcons/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
